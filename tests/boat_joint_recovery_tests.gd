extends "res://tests/observation_repeat_tests.gd"
func run():
 surface=SubViewport.new();surface.size=Vector2i(1440,900);surface.own_world_3d=true;root.add_child(surface)
 campaign=load("res://campaign/campaign.tscn").instantiate();surface.add_child(campaign);await settle(.3)
 await button(campaign.chapter_buttons[2]);level=campaign.instances[2];await button(level.learning.start_button)
 var obstruction:=Node3D.new();level.view.add_child(obstruction);level.view.fixed["test_obstruction"]=obstruction
 level.view.G.box(obstruction,Vector3(.3,.4,.3),level.view.panel_transform()*Vector3(2,0,.6),level.view.wood)
 level.view._pose_cache.clear()
 await prepare("plank_0a");await settle(.5);await Pointer.drag(surface,level.view,1.0);await wait_motion()
 check(level.state.failed and level.state.placed.size()==1 and level.state.failure_result().piece_id=="plank_0b","impossible automatic path fails after actual contact without fabricating another plank")
 check(level.panel.failure_overlay.visible,"truly blocked assembly opens failure automatically")
 check(not level.state.place_repeat("plank_0a").ok,"stale repeat cannot commit after path failure")
 level.view.fixed.erase("test_obstruction");obstruction.free();level.view._pose_cache.clear()
 await button(level.panel.failure_restart_button)
 check(level.state.placed.is_empty() and not level.state.failed,"failure restart resets the unfinished pair")
 for id in ["plank_0a","plank_1a","plank_2a","cross_upper"]:await second_trial(id,"correct")
 await prepare("three_middle");await button(level.panel.opening_buttons.B);await settle(.5);await Pointer.drag(surface,level.view,1.0);await wait_motion()
 var prefix: Dictionary=level.state.placed.duplicate(true)
 await button(level.panel.overview_button);await settle(.1);await button(campaign.back_button)
 await button(campaign.chapter_buttons[2]);await button(level.learning.start_button);await prepare("three_upper")
 await settle(.5);await Pointer.drag(surface,level.view,1.0);await wait_motion()
 check(level.state.placed==prefix and level.state.failed and level.state.failure_result().piece_id=="three_upper","wrong middle survives directory round-trip and top contact ends the impossible build")
 check(level.panel.failure_overlay.visible,"later obstruction uses the same automatic failure overlay")
 await button(level.panel.failure_restart_button)
 check(level.state.placed.is_empty() and not level.state.failed,"restart clears all preceding stock after a final-stage obstruction")
 campaign.free();surface.free()
 var report={"passed":passed,"failed":failures.size(),"failures":failures,"scope":"Actual Viewport events with a controlled additional obstruction for the automatic half; real row withdrawal/retry and directory persistence of an incorrect middle channel."}
 FileAccess.open("res://tests/boat_joint_recovery_report.json",FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
 print("BOAT_RECOVERY ",JSON.stringify(report));quit(0 if failures.is_empty() else 1)
