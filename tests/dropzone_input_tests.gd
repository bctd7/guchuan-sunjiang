extends "res://tests/observer_snap_tests.gd"
var hints: Array[String]=[]
func stroke_to(a: Vector2,b: Vector2,using_touch: bool=false,index: int=0) -> void:
	if using_touch:await touch(a,true,index)
	else:await mouse(a,true)
	if using_touch:await swipe(b,b-a,index)
	else:await move(b,b-a)
	if using_touch:await touch(b,false,index)
	else:await mouse(b,false)
func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://tests/evidence/dropzone-r3/"))
	root.size=Vector2i(1100,800)
	stage=Control.new();stage.position=Vector2(120,90);stage.size=Vector2(640,440);root.add_child(stage)
	var container:=SubViewportContainer.new();container.mouse_filter=Control.MOUSE_FILTER_IGNORE;container.stretch=true;container.stretch_shrink=2;container.size=stage.size;stage.add_child(container)
	var viewport:=SubViewport.new();viewport.own_world_3d=true;container.add_child(viewport)
	var world:=Node3D.new();viewport.add_child(world)
	camera=Camera3D.new();camera.projection=Camera3D.PROJECTION_ORTHOGONAL;camera.size=4;camera.current=true;world.add_child(camera)
	part=Node3D.new();world.add_child(part)
	var mesh:=MeshInstance3D.new();mesh.mesh=BoxMesh.new();mesh.mesh.size=Vector3(.6,.5,.5);part.add_child(mesh)
	surface=Surface.new();stage.add_child(surface)
	surface.assembly_requested.connect(func():requests+=1)
	surface.selection_required.connect(func():selection_prompts+=1)
	surface.drag_feedback.connect(func(message: String):hints.append(message))
	await process_frame
	await reset_fixture()
	check(viewport.size==Vector2i(stage.size/2),"scaled viewport has independent physical/render size")
	var a:=start();var b:=target();var count:=requests
	await stroke_to(a,a)
	check(requests==count and part.transform==initial,"click does not install")
	await mouse(a,true);await mouse(b,false)
	check(requests==count+1,"coalesced fast mouse motion can release on visible entry")
	await mouse(b,false)
	check(requests==count+1,"duplicate release does not insert twice")
	count=requests
	await reset_fixture();a=start();b=target()
	await mouse(a,true);await move(b+Vector2(0,38),b-a+Vector2(0,38))
	var displayed: Vector2=stage.position+surface._project(part.global_position)
	check(displayed.distance_to(b+Vector2(0,38))<1,"part follows free pointer in both axes through scaled/offset viewport")
	check(surface._in_capture_zone(b-stage.position+Vector2(0,38)),"visible circle accepts off-axis entry rather than old narrow corridor")
	await mouse(b+Vector2(0,38),false)
	check(requests==count+1,"off-axis visible-circle mouse drop assembles")
	count=requests
	await reset_fixture();a=start();b=target()
	await stroke_to(a,b+Vector2(-38,0))
	check(requests==count+1,"overshoot within visible region assembles")
	count=requests
	await reset_fixture();a=start();b=target()
	await stroke_to(a,b+Vector2(0,140))
	check(requests==count and part.transform==initial,"release outside visible region returns stock")
	check(not hints.is_empty() and hints.back().contains("入口"),"failed release explains the visible target")
	await mouse(a,true);await move(b,b-a);await mouse(Vector2(1090,790),false)
	check(requests==count and not surface.assembly_dragging and part.transform==initial,"outside-surface release cancels without stale capture")
	await mouse(a,true);await move(b,b-a);surface.notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT);await mouse(b,false)
	check(requests==count and part.transform==initial,"focus loss prevents phantom insertion")
	await reset_fixture(false);a=start();b=target()
	await stroke_to(a,b)
	check(requests==count and selection_prompts==1 and part.transform==initial,"missing choices prompt once and never rotate/assemble")
	await reset_fixture();a=start();b=target()
	await touch(a,true,2);await swipe(b,b-a,2);await touch(b,false,2,true)
	check(requests==count and part.transform==initial,"canceled finger never inserts")
	await stroke_to(a,b+Vector2(0,38),true,3)
	check(requests==count+1,"touch uses same visible circle as mouse")
	count=requests
	await touch(a,true,4);await swipe(b,b-a,4);await touch(a,true,5);await touch(b,false,5);await touch(b,false,4)
	check(requests==count and part.transform==initial,"second finger cancels instead of stealing gesture")
	await create_timer(.46).timeout
	await reset_fixture();a=start();b=target()
	var blank:=stage.position+Vector2(30,30)
	await mouse(blank,true);await move(a,a-blank)
	check(not surface.assembly_dragging and surface.target_angles!=Vector2.ZERO,"blank press remains orbit across stock")
	await mouse(a,false)
	await reset_fixture();a=start();b=target()
	await mouse(a,true);await move(blank,blank-a)
	check(surface.assembly_dragging and surface.target_angles==Vector2.ZERO,"stock press remains stock outside mesh")
	await mouse(blank,false)
	check(part.transform==initial,"failed locked stock gesture restores source pose")
	stage.position=Vector2(50,110);stage.size=Vector2(800,480);container.size=stage.size
	await process_frame
	await reset_fixture();a=start();b=target();count=requests
	await stroke_to(a,b+Vector2(35,22),true,10)
	check(requests==count+1,"resized offset stage keeps the same broad touch target")
	var report={"passed":passed,"failed":failures.size(),"failures":failures,"requests":requests,"method":"Program Viewport mouse/touch GUI events; free 2D movement, half-resolution render viewport, parent offset/resize, off-axis and overshoot, focus/cancel/duplicate/missing-choice guards. Not native hardware."}
	FileAccess.open("res://tests/evidence/dropzone-r3/input-report.json",FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
	print("DROPZONE_INPUT ",passed," passed; ",failures.size()," failed")
	stage.free();quit(0 if failures.is_empty() else 1)
