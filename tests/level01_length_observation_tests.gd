extends "res://tests/level01_input_tests.gd"
## All joint families expose measured lengths; wrong lengths can be installed.
func run() -> void:
	root.size=Vector2i(1440,900)
	level=load("res://levels/level01/level01.tscn").instantiate()
	root.add_child(level)
	level.learning.start_button.pressed.emit()
	await settle()
	check(level.joint_type.is_empty() and level.tenon_length.is_empty(),"fresh controller defaults neither type nor length")
	for id in level.Rules.REPRESENTATIVE_IDS:
		await select_piece(id)
		check(level.inspector.selected_joint.is_empty() and level.inspector.selected_length.is_empty(),"new group never inherits answers: "+id)
		check(level.inspector.length_buttons.size()==3 and level.inspector.candidate_panel.visible,"all families expose three measured length choices: "+id)
		var before:=geometry_signature(level.view.pieces[id])
		var signatures: Dictionary={}
		for kind in ["blind_tenon","dovetail","through_tenon"]:
			await button(level.inspector.joint_buttons[kind])
			check(level.inspector.selected_joint==kind,"chosen type updates candidate selection: "+id+"/"+kind)
			await button(level.inspector.length_buttons["correct"])
			signatures[kind]=geometry_signature(level.inspector.animated_piece)
			check(level.inspector.selected_length=="correct" and level.tenon_length=="correct","type and length synchronize to controller: "+id+"/"+kind)
			check(not level.busy and geometry_signature(level.view.pieces[id])==before,"candidate observation never changes world geometry: "+id+"/"+kind)
			if id=="rib_l1":
				var part=level.inspector.animated_piece
				var tip: MeshInstance3D=part.get_node(part.get_meta("candidate_tip_path")) if part.has_meta("candidate_tip_path") else part.find_child("RootTenon",true,false)
				var bounds: AABB=tip.global_transform*tip.mesh.get_aabb()
				check(bounds.end.x<-.55,"candidate starts fully outside receiving stock before trial: "+kind)
		check(signatures.blind_tenon!=signatures.dovetail and signatures.blind_tenon!=signatures.through_tenon and signatures.dovetail!=signatures.through_tenon,"three type candidates have distinct real geometry: "+id)
		var expected: String=level.Rules.expected_joint(id)
		await button(level.inspector.joint_buttons[expected])
		var length_shapes: Dictionary={}
		for length in ["long","short","correct"]:
			await button(level.inspector.length_buttons[length])
			check(level.inspector.selected_length==length and level.tenon_length==length,"length card explicitly selects candidate: "+id+"/"+length)
			check(level.inspector.selected_joint==expected,"length card preserves selected type: "+id+"/"+length)
			check(level.inspector.comparison.piece_id==id and level.inspector.comparison.selected_length==length and level.inspector.comparison.pixel_scale>0,"same-scale measurement follows selection: "+id+"/"+length)
			check(is_equal_approx(float(level.inspector.animated_piece.get_meta("length_geometry").span),level.view.Lengths.span(id,length)),"candidate measurement matches physical length: "+id+"/"+length)
			length_shapes[length]=geometry_signature(level.inspector.animated_piece)
			await button(level.inspector.close_button)
			await button(level.panel.inspect_button)
			check(level.inspector.selected_length==length and level.inspector.selected_joint==expected,"reopen preserves both answers: "+id+"/"+length)
		check(length_shapes.short!=length_shapes.correct and length_shapes.long!=length_shapes.correct and length_shapes.short!=length_shapes.long,"all three lengths produce distinct geometry: "+id)
		var wrong: String="dovetail" if expected!="dovetail" else "blind_tenon"
		await button(level.inspector.joint_buttons[wrong])
		check(level.inspector.selected_length=="correct","type change preserves explicit length: "+id)
		await button(level.inspector.close_button)
		await click(level.view.socket_screen_position(id))
		check(level.state.placed.has(id) and level.state.placed[id].joint==wrong and level.busy,"wrong type also enters a trial with valid length: "+id)
		await settle(3.0)
		await button(level.inspector.retry_button)
		check(not level.state.placed.has(id) and not level.busy,"wrong-type trial can be taken back for length comparison: "+id)
		var chosen: String="long" if id=="bow" else "short"
		await choose_joint(expected,chosen)
		await click(level.view.socket_screen_position(id))
		check(level.state.placed.has(id) and level.state.placed[id].length==chosen,"wrong length installs for later inspection: "+id)
		await finish_review()
		for auto_id in level.Rules.AUTO_GROUPS[id]:
			check(level.state.placed[auto_id].length==chosen,"automatic group inherits wrong length: "+auto_id)
			check(level.view.pieces[auto_id].transform.is_equal_approx(level.view.final_pose(auto_id,chosen)),"automatic mesh reaches legal length-specific pose: "+auto_id)
		check(level.joint_type.is_empty() and level.tenon_length.is_empty(),"next task clears both choices: "+id)
	check(level.state.progress_count()==3 and level.state.automatic_count()==7 and level.state.installed_count()==10,"wrong lengths count as three manual plus seven attached automatic pieces")
	check(not level.panel.check_button.disabled and not level.state.is_stable(),"complete attached frame can request explicit stability check")
	await button(level.panel.check_button)
	check(not level.state.completed and not level.panel.success_panel.visible and level.busy,"wrong lengths fail check and start instability feedback")
	await settle(2.5)
	check(not level.busy and level.state.validate_structure().code=="unstable_length","failed check restores control and unstable diagnosis")
	await button(level.panel.undo_button)
	check(not level.state.placed.has("beam1") and not level.state.placed.has("beam3") and level.state.progress_count()==2,"wrong final group can be withdrawn for correction")
	await select_piece("beam1")
	check(level.inspector.selected_joint.is_empty() and level.inspector.selected_length.is_empty(),"withdrawal clears both prior choices")
	await button(level.inspector.close_button)
	await button(level.panel.restart_button)
	await button(level.panel.inspect_button)
	check(level.inspector.selected_joint.is_empty() and level.inspector.selected_length.is_empty() and level.tenon_length.is_empty(),"reset returns to no implied type or length answer")
	await button(level.inspector.close_button)
	check(not level.busy and level.state.placed.size()==1,"unchosen observation starts no automatic assembly")
	report("res://tests/level01_length_observation_report.json","LEVEL01 LENGTH OBSERVATION")
